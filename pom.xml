<?xml version="1.0" encoding="UTF-8"?>
<!--
    This is the Maven build file. It tells Maven three things:
      1. what the project is called,
      2. which libraries it needs (Maven downloads them for you), and
      3. how to build and run it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent picks compatible versions of every library for us. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>io.github.hamzahamidhar</groupId>
    <artifactId>fraud-detection-service</artifactId>
    <version>1.0.0</version>
    <name>Fraud Detection Service</name>
    <description>Scores card payments for fraud risk using rules plus a small machine learning model</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- The web server and REST API support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Saving and loading Java objects from a SQL database (JPA / Hibernate). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Checks incoming requests, e.g. "amount must be positive". -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- A small SQL database that runs inside the app, so there is nothing to install. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JUnit 5, Mockito and Spring's testing tools. Only used when running tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lets you run the app with "mvn spring-boot:run" and package it as one .jar file. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
